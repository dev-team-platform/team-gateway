{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4201",
      "http://localhost:4202",
      "http://localhost:4203",
      "http://localhost:4204",
      "http://localhost:4205",
      "http://localhost:4206"
    ]
  },
  "Redis": {
    "ConnectionString": "YOUR_REDIS_CONNECTION_STRING (string)"
  },
  "Auth": {
    "AllowRedirectOrigins": [
      "http://localhost:4201",
      "http://localhost:4202",
      "http://localhost:4203",
      "http://localhost:4204",
      "http://localhost:4205",
      "http://localhost:4206"
    ],
    "Cookie": {
      "CookieName": "YOUR_AUTH_COOKIE_NAME (string)",
      "HttpOnly": "YOUR_AUTH_COOKIE_HTTP_ONLY (bool)",
      "SameSite": "YOUR_AUTH_COOKIE_SAME_SITE (string)",
      "SecurePolicy": "YOUR_AUTH_COOKIE_SECURE_POLICY (string)",
      "ExpireTimeSpan": "YOUR_AUTH_COOKIE_EXPIRE_TIME_SPAN (timespan)",
      "SlidingExpiration": "YOUR_AUTH_COOKIE_SLIDING_EXPIRATION (bool)",
      "Path": "YOUR_AUTH_COOKIE_PATH (string)"
    },
    "Keycloak": {
      "Authority": "YOUR_KEYCLOAK_AUTHORITY_URL (string)",
      "ClientId": "YOUR_KEYCLOAK_CLIENT_ID (string)",
      "ClientSecret": "YOUR_KEYCLOAK_CLIENT_SECRET (string)",
      "CallbackPath": "YOUR_KEYCLOAK_CALLBACK_PATH (string)",
      "SignedOutCallbackPath": "YOUR_KEYCLOAK_SIGNED_OUT_CALLBACK_PATH (string)",
      "RefreshBeforeExpiry": "00:02:00",
      "RefreshLockTimeout": "00:00:30"
    },
    "InternalJwt": {
      "Issuer": "YOUR_INTERNAL_JWT_ISSUER (string)",
      "AudienceMappings": {
        "notification-service": "team-notification-service"
      },
      "PrivateKeyPemPath": "YOUR_INTERNAL_JWT_PRIVATE_KEY_PEM_PATH (string)",
      "Lifetime": "00:05:00"
    }
  },
  "Antiforgery": {
    "HeaderName": "YOUR_ANTIFORGERY_HEADER_NAME (string)",
    "CookieName": "YOUR_ANTIFORGERY_COOKIE_NAME (string)",
    "RequestTokenCookieName": "YOUR_ANTIFORGERY_REQUEST_TOKEN_COOKIE_NAME (string)",
    "SameSite": "YOUR_ANTIFORGERY_SAME_SITE (string)",
    "SecurePolicy": "YOUR_ANTIFORGERY_SECURE_POLICY (string)",
    "Path": "YOUR_ANTIFORGERY_PATH (string)"
  },
  "RateLimiter": {
    "Auth": {
      "PermitLimit": 5,
      "Window": "00:01:00",
      "SegmentsPerWindow": 6,
      "QueueLimit": 0
    },
    "Default": {
      "TokenLimit": 200,
      "TokensPerPeriod": 100,
      "ReplenishmentPeriod": "00:00:10",
      "QueueLimit": 0
    }
  },
  "ReverseProxy": {
    "Routes": {
      "notification-hub": {
        "ClusterId": "notification-service",
        "AuthorizationPolicy": "gateway-session",
        "Match": {
          "Path": "/hubs/notifications/{**catch-all}"
        }
      },
      "notification-api": {
        "ClusterId": "notification-service",
        "AuthorizationPolicy": "gateway-session",
        "Match": {
          "Path": "/notifications/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/notifications"
          }
        ]
      }
    },
    "Clusters": {
      "notification-service": {
        "Destinations": {
          "primary": {
            "Address": "YOUR_NOTIFICATION_SERVICE_ADDRESS (uri)"
          }
        }
      }
    }
  }
}
